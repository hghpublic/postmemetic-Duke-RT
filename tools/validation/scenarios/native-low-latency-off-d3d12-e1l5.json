{
  "name": "native-low-latency-off-d3d12-e1l5",
  "backend": "d3d12",
  "map": "e1l5",
  "debugMode": 0,
  "traceFrames": 32,
  "captureWhenPassed": true,
  "minSelfTestFrames": 16,
  "extraArgs": [
    "+set",
    "nri_framegen",
    "false",
    "+set",
    "nri_lowlatency",
    "false",
    "+set",
    "nri_ptframesinflight",
    "3",
    "+set",
    "nri_ptloadingvoxelvariants",
    "128",
    "+set",
    "nri_ptloadingvoxelblockoptional",
    "false"
  ],
  "commands": "+wait 45; map e1l5; wait 1; closemenu",
  "requiredPrefixes": [
    "NRI PT selftest:",
    "NRI PT frame boundary:",
    "NRI PT low-latency:"
  ],
  "prefixAssertions": [
    {
      "prefix": "NRI PT low-latency:",
      "minCount": 16,
      "applyTo": "all",
      "fields": {
        "schema": { "exact": 2 },
        "request": { "exact": "off" },
        "owner": { "exact": "none" },
        "framegen": { "exact": "off" },
        "feature": { "exact": "yes" },
        "iface": { "exact": "yes" },
        "swapchain": { "exact": "no" },
        "operational": { "exact": "no" },
        "configured": { "exact": "no" },
        "canonical_sample": { "exact": "first-input-gather" },
        "submit_associated": { "exact": "no" },
        "sleep": { "exact": "no" },
        "count": { "exact": 0 },
        "markers": { "exact": 0 },
        "complete": { "exact": 0 },
        "aborted": { "exact": 0 },
        "contract": { "exact": "incomplete" },
        "sleep_seq": { "exact": 0 },
        "sim_start_seq": { "exact": 0 },
        "input_seq": { "exact": 0 },
        "sim_end_seq": { "exact": 0 },
        "submit_start_seq": { "exact": 0 },
        "submit_end_seq": { "exact": 0 },
        "present_start_seq": { "exact": 0 },
        "present_end_seq": { "exact": 0 },
        "extra_sample_attempts": { "exact": 0 },
        "present": { "exact": "no" },
        "submit_ok": { "exact": "no" },
        "present_ok": { "exact": "no" },
        "runtime_suppressed": { "exact": "no" },
        "runtime_failure": { "exact": "none" },
        "runtime_disable": { "exact": "failure" },
        "set_mode": { "exact": "failure" },
        "sleep_result": { "exact": "failure" },
        "input_result": { "exact": "failure" },
        "sim": { "exact": "failure/failure" },
        "submit": { "exact": "failure/failure" },
        "report_scope": { "exact": "latest_available_unjoined" },
        "report": { "exact": "failure" }
      }
    },
    {
      "prefix": "NRI PT frame boundary:",
      "minCount": 16,
      "applyTo": "all",
      "fields": {
        "rendered_limit": { "exact": 3 },
        "physical_qframes": { "exact": 3 },
        "admission_waited": { "exact": 0 }
      }
    }
  ],
  "forbiddenPatterns": [
    "Device removed",
    "device lost",
    "validation error",
    "failed to create",
    "assertion failed",
    "fatal error"
  ]
}
